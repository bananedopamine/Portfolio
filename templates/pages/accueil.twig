{% extends 'layout/base.twig' %}

{% block title %}Accueil{% endblock %}
{% block meta_description %}Portfolio de {{ profil.prenom ?? '' }} {{ profil.nom ?? '' }} — {{ profil.titre ?? 'Étudiant BTS' }}{% endblock %}

{% block content %}
<section class="hero">

    <div class="hero__eyebrow">
        <span class="hero__badge">Disponible · {{ profil.localisation ?? 'France' }}</span>
    </div>

    <h1 class="hero__name">
        <span class="hero__name-first">{{ profil.prenom ?? 'Prénom' }}</span>
        <em class="hero__name-last">{{ profil.nom ?? 'Nom' }}</em>
    </h1>

    <p class="hero__title">{{ profil.titre ?? 'Étudiant BTS SIO' }}</p>

    <p class="hero__intro">{{ profil.accroche ?? 'Passionné par le développement et les nouvelles technologies.' }}</p>

    <div class="hero__actions">
        <a href="/contact" class="btn btn--primary">Me contacter</a>
        <a href="/missions" class="btn btn--ghost">Voir mes réalisations</a>
    </div>

    <!-- Decorative grid -->
    <div class="hero__grid" aria-hidden="true">
        <div class="hero__grid-line"></div>
        <div class="hero__grid-line"></div>
        <div class="hero__grid-line"></div>
    </div>

    <!-- Stats rapides -->
    {% if data.stats is defined %}
    <ul class="hero__stats" role="list">
        {% for stat in data.stats %}
        <li class="hero__stat">
            <span class="hero__stat-value">{{ stat.valeur }}</span>
            <span class="hero__stat-label">{{ stat.label }}</span>
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <ul class="hero__stats" role="list">
        <li class="hero__stat">
            <span class="hero__stat-value">BTS</span>
            <span class="hero__stat-label">Formation en cours</span>
        </li>
        <li class="hero__stat">
            <span class="hero__stat-value">2+</span>
            <span class="hero__stat-label">Stages effectués</span>
        </li>
        <li class="hero__stat">
            <span class="hero__stat-value">10+</span>
            <span class="hero__stat-label">Projets réalisés</span>
        </li>
    </ul>
    {% endif %}
</section>

<!-- Section navigation rapide -->
<section class="quick-nav">
    <ul class="quick-nav__grid" role="list">
        {% set shortcuts = [
            { slug: 'parcours',   label: 'Parcours',    desc: 'Formation & écoles' },
            { slug: 'experience', label: 'Expérience',  desc: 'Stages & emplois' },
            { slug: 'missions',   label: 'Missions',    desc: 'Réalisations BTS' },
            { slug: 'veille',     label: 'Veille',      desc: 'Articles & techno' },
        ] %}
        {% for item in shortcuts %}
        <li>
            <a href="/{{ item.slug }}" class="quick-nav__card">
                <span class="quick-nav__card-label">{{ item.label }}</span>
                <span class="quick-nav__card-desc">{{ item.desc }}</span>
                <span class="quick-nav__card-arrow" aria-hidden="true">↗</span>
            </a>
        </li>
        {% endfor %}
    </ul>
</section>
{% endblock %}
