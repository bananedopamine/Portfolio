{% extends 'layout/base.twig' %}

{% block title %}Missions{% endblock %}

{% block content %}
{% include 'partials/section-header.twig' with {
    label: '04 — Réalisations',
    heading: 'Mes missions',
    subtext: 'Projets réalisés durant le BTS et compétences développées.'
} %}

<!-- Filtres par compétence -->
{% if data.competences_bts is defined %}
<div class="filter-bar" role="group" aria-label="Filtrer par compétence">
    <button class="filter-btn filter-btn--active" data-filter="all">Tout afficher</button>
    {% for comp in data.competences_bts %}
    <button class="filter-btn" data-filter="{{ comp.code | lower | replace({' ': '-'}) }}">{{ comp.code }}</button>
    {% endfor %}
</div>
{% endif %}

<!-- Grille des missions -->
<div class="missions-grid" id="missionsGrid">
    {% if data.missions is defined and data.missions %}
        {% for mission in data.missions %}
        <article class="mission-card"
            data-competences="{{ mission.competences | map(c => c | lower | replace({' ': '-'})) | join(' ') }}">

            {% if mission.image is defined %}
            <div class="mission-card__cover">
                <img src="{{ mission.image }}" alt="{{ mission.titre }}" loading="lazy">
            </div>
            {% else %}
            <div class="mission-card__cover mission-card__cover--empty" aria-hidden="true">
                <span class="mission-card__cover-index">{{ loop.index | format('%02d') }}</span>
            </div>
            {% endif %}

            <div class="mission-card__body">
                <div class="mission-card__header">
                    <time class="timeline__date">{{ mission.periode ?? '' }}</time>
                    <span class="exp__type">{{ mission.contexte ?? 'BTS' }}</span>
                </div>

                <h3 class="mission-card__title">{{ mission.titre }}</h3>
                <p class="mission-card__desc">{{ mission.description }}</p>

                {% if mission.competences is defined %}
                <ul class="card__tags" role="list">
                    {% for comp in mission.competences %}
                    <li class="card__tag">{{ comp }}</li>
                    {% endfor %}
                </ul>
                {% endif %}

                {% if mission.technologies is defined %}
                <ul class="mission-card__techs" role="list">
                    {% for tech in mission.technologies %}
                    <li class="mission-card__tech">{{ tech }}</li>
                    {% endfor %}
                </ul>
                {% endif %}

                <div class="mission-card__footer">
                    {% if mission.lien_demo is defined %}
                    <a href="{{ mission.lien_demo }}" class="card__link" target="_blank" rel="noopener noreferrer">
                        Démo <span aria-hidden="true">↗</span>
                    </a>
                    {% endif %}
                    {% if mission.lien_rapport is defined %}
                    <a href="{{ mission.lien_rapport }}" class="card__link" target="_blank" rel="noopener noreferrer">
                        Rapport <span aria-hidden="true">↗</span>
                    </a>
                    {% endif %}
                </div>
            </div>
        </article>
        {% endfor %}
    {% else %}
        <p class="empty-state">Aucune mission renseignée. Ajoutez vos données dans <code>data/missions.json</code>.</p>
    {% endif %}
</div>

<!-- Tableau de synthèse PDF -->
<section class="section-block">
    {% include 'partials/section-header.twig' with {
        label: 'Document officiel',
        heading: 'Tableau de synthèse des réalisations'
    } %}

    <div class="pdf-viewer-wrapper">
        <div class="pdf-viewer-preview">
            <div class="pdf-viewer-preview__icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                    <polyline points="10 9 9 9 8 9"/>
                </svg>
            </div>
            <div class="pdf-viewer-preview__info">
                <p class="pdf-viewer-preview__name">Grille_E5_Dufour_Marc.pdf</p>
                <p class="pdf-viewer-preview__meta">Tableau de synthèse BTS SIO — Session 2025</p>
            </div>
            <div class="pdf-viewer-preview__actions">
                <button class="card__link pdf-open-btn" id="pdfOpenBtn" aria-haspopup="dialog">
                    Consulter <span aria-hidden="true">↗</span>
                </button>
                <a href="{{ data.grille_pdf ?? '/documents/Grille_E5_Dufour_Marc.pdf' }}"
                   class="card__link" download aria-label="Télécharger le tableau de synthèse">
                    Télécharger <span aria-hidden="true">↓</span>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Modale lecteur PDF -->
<div class="pdf-modal" id="pdfModal" role="dialog" aria-modal="true" aria-label="Lecteur PDF" hidden>
    <div class="pdf-modal__backdrop" id="pdfModalBackdrop"></div>
    <div class="pdf-modal__container">
        <header class="pdf-modal__header">
            <span class="pdf-modal__title">Tableau de synthèse des réalisations</span>
            <div class="pdf-modal__controls">
                <div class="pdf-modal__nav">
                    <button class="pdf-modal__nav-btn" id="pdfPrev" aria-label="Page précédente">&#8592;</button>
                    <span class="pdf-modal__page-info">
                        Page <span id="pdfCurrentPage">1</span> / <span id="pdfTotalPages">—</span>
                    </span>
                    <button class="pdf-modal__nav-btn" id="pdfNext" aria-label="Page suivante">&#8594;</button>
                </div>
                <div class="pdf-modal__zoom">
                    <button class="pdf-modal__nav-btn" id="pdfZoomOut" aria-label="Dézoomer">−</button>
                    <span class="pdf-modal__zoom-level" id="pdfZoomLevel">100%</span>
                    <button class="pdf-modal__nav-btn" id="pdfZoomIn" aria-label="Zoomer">+</button>
                </div>
                <button class="pdf-modal__close" id="pdfModalClose" aria-label="Fermer">&times;</button>
            </div>
        </header>
        <div class="pdf-modal__body">
            <canvas id="pdfCanvas"></canvas>
        </div>
    </div>
</div>

<!-- Tableau des compétences BTS -->
{% if data.competences_bts is defined %}
<section class="section-block">
    {% include 'partials/section-header.twig' with {
        label: 'Référentiel',
        heading: 'Compétences BTS SIO'
    } %}

    <div class="competences-table-wrapper">
        <table class="competences-table" role="table">
            <thead>
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Compétence</th>
                    <th scope="col">Missions associées</th>
                    <th scope="col">Niveau</th>
                </tr>
            </thead>
            <tbody>
                {% for comp in data.competences_bts %}
                <tr>
                    <td><code class="comp-code">{{ comp.code }}</code></td>
                    <td>{{ comp.libelle }}</td>
                    <td>
                        <ul class="comp-missions" role="list">
                            {% for m in comp.missions %}
                            <li>{{ m }}</li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td>
                        <span class="comp-level comp-level--{{ comp.niveau | lower }}">{{ comp.niveau }}</span>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endif %}
{% endblock %}

{% block extra_scripts %}
<!-- PDF.js via CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
// ── Configuration PDF.js ──────────────────────────
pdfjsLib.GlobalWorkerOptions.workerSrc =
    'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

const PDF_URL = '{{ data.grille_pdf ?? "/assets/Grille_E5_Dufour_Marc.pdf" }}';

// ── État ──────────────────────────────────────────
let pdfDoc      = null;
let currentPage = 1;
let totalPages  = 0;
let scale       = 1.3;
const SCALE_STEP = 0.2;
const SCALE_MIN  = 0.6;
const SCALE_MAX  = 2.5;

// ── Éléments DOM ─────────────────────────────────
const modal        = document.getElementById('pdfModal');
const backdrop     = document.getElementById('pdfModalBackdrop');
const canvas       = document.getElementById('pdfCanvas');
const ctx          = canvas.getContext('2d');
const elCurrent    = document.getElementById('pdfCurrentPage');
const elTotal      = document.getElementById('pdfTotalPages');
const elZoom       = document.getElementById('pdfZoomLevel');
const btnPrev      = document.getElementById('pdfPrev');
const btnNext      = document.getElementById('pdfNext');
const btnZoomIn    = document.getElementById('pdfZoomIn');
const btnZoomOut   = document.getElementById('pdfZoomOut');
const btnOpen      = document.getElementById('pdfOpenBtn');
const btnClose     = document.getElementById('pdfModalClose');

// ── Rendu d'une page ─────────────────────────────
async function renderPage(num) {
    const page = await pdfDoc.getPage(num);
    const viewport = page.getViewport({ scale });
    canvas.width  = viewport.width;
    canvas.height = viewport.height;
    await page.render({ canvasContext: ctx, viewport }).promise;
    elCurrent.textContent = num;
    btnPrev.disabled = num <= 1;
    btnNext.disabled = num >= totalPages;
    elZoom.textContent = Math.round(scale * 100) + '%';
}

// ── Chargement du PDF ────────────────────────────
async function loadPDF() {
    if (pdfDoc) return; // déjà chargé
    try {
        pdfDoc = await pdfjsLib.getDocument(PDF_URL).promise;
        totalPages = pdfDoc.numPages;
        elTotal.textContent = totalPages;
        await renderPage(currentPage);
    } catch (e) {
        canvas.parentElement.innerHTML =
            '<p style="color:var(--clr-accent,#7c6ef2);padding:2rem;text-align:center">' +
            'Impossible de charger le PDF. Vérifiez le chemin du fichier.</p>';
    }
}

// ── Ouverture / Fermeture ────────────────────────
function openModal() {
    modal.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    loadPDF();
    btnClose.focus();
}
function closeModal() {
    modal.setAttribute('hidden', '');
    document.body.style.overflow = '';
    btnOpen.focus();
}

// ── Événements ───────────────────────────────────
btnOpen.addEventListener('click', openModal);
btnClose.addEventListener('click', closeModal);
backdrop.addEventListener('click', closeModal);

btnPrev.addEventListener('click', async () => {
    if (currentPage > 1) { currentPage--; await renderPage(currentPage); }
});
btnNext.addEventListener('click', async () => {
    if (currentPage < totalPages) { currentPage++; await renderPage(currentPage); }
});
btnZoomIn.addEventListener('click', async () => {
    if (scale < SCALE_MAX) { scale = Math.min(scale + SCALE_STEP, SCALE_MAX); await renderPage(currentPage); }
});
btnZoomOut.addEventListener('click', async () => {
    if (scale > SCALE_MIN) { scale = Math.max(scale - SCALE_STEP, SCALE_MIN); await renderPage(currentPage); }
});

// Fermeture au clavier (Échap)
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hasAttribute('hidden')) closeModal();
    if (e.key === 'ArrowLeft'  && !modal.hasAttribute('hidden')) btnPrev.click();
    if (e.key === 'ArrowRight' && !modal.hasAttribute('hidden')) btnNext.click();
});

// ── Filtre missions côté client
const btns = document.querySelectorAll('.filter-btn');
const cards = document.querySelectorAll('.mission-card');

btns.forEach(btn => {
    btn.addEventListener('click', () => {
        btns.forEach(b => b.classList.remove('filter-btn--active'));
        btn.classList.add('filter-btn--active');

        const filter = btn.dataset.filter;
        cards.forEach(card => {
            if (filter === 'all' || card.dataset.competences.includes(filter)) {
                card.style.display = '';
                card.style.opacity = '1';
            } else {
                card.style.opacity = '0';
                card.style.display = 'none';
            }
        });
    });
});
</script>
{% endblock %}
